{
  "name": "ExhibitionItem",
  "type": "object",
  "properties": {
    "title": {
      "type": "string"
    },
    "artist_name": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "location": {
      "type": "string"
    },
    "age": {
      "type": "string"
    },
    "community_member": {
      "type": "boolean",
      "default": false
    },
    "about_artist": {
      "type": "string"
    },
    "artwork_story": {
      "type": "string"
    },
    "audience_connection": {
      "type": "string"
    },
    "technical_details": {
      "type": "string"
    },
    "ac_field": {
      "type": "string"
    },
    "file_url": {
      "type": "string"
    },
    "images": {
      "type": "string"
    },
    "text_permission": {
      "type": "boolean",
      "default": false
    },
    "photo_permission": {
      "type": "boolean",
      "default": false
    },
    "slug": {
      "type": "string"
    },
    "image_url": {
      "type": "string"
    },
    "sort_order": {
      "type": "number",
      "default": 0
    }
  },
  "required": [
    "title",
    "artist_name",
    "slug"
  ],
  "rls": {
    "read": {},
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}