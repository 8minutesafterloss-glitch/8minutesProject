{
  "name": "JournalEntry",
  "type": "object",
  "properties": {
    "text": {
      "type": "string",
      "maxLength": 1000
    },
    "emoji": {
      "type": "string"
    }
  },
  "required": [
    "text"
  ],
  "rls": {
    "read": {
      "created_by_id": "{{user.id}}"
    },
    "create": {
      "created_by_id": "{{user.id}}"
    },
    "update": {
      "created_by_id": "{{user.id}}"
    },
    "delete": {
      "created_by_id": "{{user.id}}"
    }
  }
}